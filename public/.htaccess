# Structural Canvas CPT library: send every request to index.php.
# (No FilesMatch deny here: Apache checks it before the rewrite, against the
# requested name, so it refused every API path. The folder holds only
# index.php and this file, and every request is rewritten to index.php.)
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
